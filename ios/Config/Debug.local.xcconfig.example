// Copy this file to Debug.local.xcconfig in the same directory.
// Debug.local.xcconfig is gitignored and overrides Debug.xcconfig.
//
// Tracked Debug builds already use https://data.organizedglitter.app.
// Use this file only when you want a different PocketBase, for example:
// - Hosted:   POCKETBASE_BASE_URL = https:/$()/data.organizedglitter.app
// - LAN host: POCKETBASE_BASE_URL = http:/$()/192.168.1.42:8090
POCKETBASE_BASE_URL = http:/$()/127.0.0.1:8090
